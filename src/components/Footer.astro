---
import { getPath } from '../utils/paths';
---
<footer class="mt-auto border-t border-white/10 bg-white/5 backdrop-blur-sm py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-slate-400 text-sm text-center md:text-left">
        &copy; {new Date().getFullYear()} E3M Solutions. Engenharia Prática, IA, Resultados.<br/>Todos os direitos reservados.
      </div>
      
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="https://www.linkedin.com/company/e3m-br/posts" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-accent-cyan transition-colors">
          LinkedIn Empresa
        </a>
        <a href="https://www.linkedin.com/in/marciofigueiredoweb" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-accent-cyan transition-colors">
          LinkedIn Fundador
        </a>
        <a href="https://github.com/marciofweb" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-accent-cyan transition-colors">
          GitHub
        </a>
        <a href="https://x.com/ai_mf_e3msol" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-accent-cyan transition-colors">
          X (Twitter)
        </a>
      </div>

      <div class="flex space-x-4 text-sm">
        <a href={getPath('/privacidade')} class="text-slate-400 hover:text-white transition-colors">Privacidade</a>
        <a href={getPath('/termos')} class="text-slate-400 hover:text-white transition-colors">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
