---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Tabela de referência (R$/hora PJ, remoto). Mensal = taxa × h/sem × 4,33.
const PERFIS = [
	{ id: 'dev', nome: 'Dev front/back', taxas: { jr: 100, pleno: 125, sr: 150 } },
	{ id: 'full', nome: 'Dev full-stack / mobile', taxas: { jr: 110, pleno: 135, sr: 160 } },
	{ id: 'qa', nome: 'QA / testes', taxas: { jr: 90, pleno: 115, sr: 140 } },
	{ id: 'ux', nome: 'UX / produto', taxas: { jr: 95, pleno: 120, sr: 145 } },
	{ id: 'ia', nome: 'IA / dados / automação', taxas: { jr: 130, pleno: 160, sr: 190 } },
	{ id: 'lead', nome: 'Tech Lead as a Service (sênior)', taxas: { sr: 210 } },
];
---

<Layout title="Calcule seu profissional alocado | E3M Solutions">
	<Header />

	<main class="flex-grow pt-24 pb-20 overflow-hidden">
		<section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8 text-center">
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6 leading-tight text-white">
				Calcule seu <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-blue-400 to-accent-violet">time alocado</span>
			</h1>
			<p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
				Monte sua lista de profissionais — perfil, senioridade, dedicação e quantidade — e veja a estimativa mensal. Sem reunião comercial.
			</p>
		</section>

		<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="glass-panel p-6 sm:p-8 rounded-3xl border border-white/10">
				<div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-4">
					<select id="f-perfil" class="rounded-xl bg-slate-900 border border-white/10 px-3 py-3 text-white text-sm">
						{PERFIS.map((p) => <option value={p.id}>{p.nome}</option>)}
					</select>
					<select id="f-senior" class="rounded-xl bg-slate-900 border border-white/10 px-3 py-3 text-white text-sm">
						<option value="jr">Júnior</option>
						<option value="pleno" selected>Pleno</option>
						<option value="sr">Sênior</option>
					</select>
					<select id="f-horas" class="rounded-xl bg-slate-900 border border-white/10 px-3 py-3 text-white text-sm">
						<option value="80">20h/sem</option>
						<option value="120">30h/sem</option>
						<option value="160" selected>40h/sem</option>
					</select>
					<select id="f-qtd" class="rounded-xl bg-slate-900 border border-white/10 px-3 py-3 text-white text-sm">
						<option value="1">1x</option>
						<option value="2">2x</option>
						<option value="3">3x</option>
						<option value="4">4x</option>
						<option value="5">5x</option>
					</select>
					<button id="f-add" class="rounded-xl bg-accent-cyan text-slate-950 font-bold text-sm px-4 py-3">Adicionar</button>
				</div>

				<div id="linhas" class="space-y-2"></div>
				<p id="vazio" class="text-sm text-slate-400 text-center py-4">Nenhum profissional ainda — adicione o primeiro acima.</p>

				<div class="rounded-2xl bg-accent-cyan/[0.06] border border-accent-cyan/30 p-6 text-center mt-4">
					<p class="text-sm text-slate-300 mb-1">Estimativa mensal total</p>
					<p id="total" class="text-3xl font-extrabold text-white">R$ 0</p>
					<p class="text-xs text-slate-400 mt-2">Faixas de referência E3M (PJ, remoto). Valor final no diagnóstico gratuito.</p>
				</div>
				<div class="text-center mt-4">
					<a id="cta" href="/contato" class="inline-block px-8 py-3 rounded-xl bg-accent-cyan text-slate-950 font-bold">Solicitar profissionais / orçamento</a>
					<p class="text-xs text-slate-400 mt-3">Início típico em 1–2 semanas. Sem multa após 90 dias.</p>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<script define:vars={{ perfis: PERFIS }}>
		const linhas = [];
		const $ = (id) => document.getElementById(id);
		const fmt = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
		const taxaDe = (pid, sen) => perfis.find((p) => p.id === pid).taxas[sen];
		const nomeDe = (pid) => perfis.find((p) => p.id === pid).nome;

		function ajustarSenioridade() {
			const sel = $('f-senior');
			if ($('f-perfil').value === 'lead') {
				sel.innerHTML = '<option value="sr" selected>Sênior — R$ 210/h referência</option>';
			} else if (sel.options.length < 3) {
				sel.innerHTML = '<option value="jr">Júnior</option><option value="pleno" selected>Pleno</option><option value="sr">Sênior</option>';
			}
		}
		$('f-perfil').addEventListener('change', ajustarSenioridade);

		function mensal(taxa, horasMes, qtd) { return Math.round(taxa * horasMes * qtd / 100) * 100; }

		function render() {
			const box = $('linhas');
			box.innerHTML = '';
			let total = 0;
			linhas.forEach((l, i) => {
				const m = mensal(l.taxa, l.horas, l.qtd);
				total += m;
				const div = document.createElement('div');
				div.className = 'flex items-center justify-between gap-2 rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-sm';
				div.innerHTML = `<span class="text-slate-200">${l.qtd}x ${l.nome} · ${l.sen} · ${l.horas / 4}h/sem · ${fmt(l.taxa)}/h</span>
					<span class="flex items-center gap-3"><b class="text-white">${fmt(m)}/mês</b>
					<button data-i="${i}" class="rm text-slate-400 hover:text-red-400 text-lg leading-none">×</button></span>`;
				box.appendChild(div);
			});
			box.querySelectorAll('.rm').forEach((b) => b.addEventListener('click', () => {
				linhas.splice(Number(b.dataset.i), 1);
				render();
			}));
			$('vazio').style.display = linhas.length ? 'none' : 'block';
			$('total').textContent = fmt(total);
			const texto = linhas.map((l) => `- ${l.qtd}x ${l.nome} (${l.sen}, ${l.horas / 4}h/sem, ${fmt(l.taxa)}/h) = ${fmt(mensal(l.taxa, l.horas, l.qtd))}/mês`).join('\n');
			const msg = `Olá! Montei esta estimativa na calculadora E3M:\n\n${texto}\n\nTOTAL ESTIMADO: ${fmt(total)}/mês\n\nQuero solicitar profissionais / orçamento.`;
			$('cta').href = '/contato?service=staff-augmentation&message=' + encodeURIComponent(msg);
		}

		$('f-add').addEventListener('click', () => {
			const pid = $('f-perfil').value;
			const sen = $('f-senior').value;
			linhas.push({ nome: nomeDe(pid), sen: $('f-senior').selectedOptions[0].text.split(' ')[0], taxa: taxaDe(pid, sen), horas: Number($('f-horas').value), qtd: Number($('f-qtd').value) });
			render();
		});
		render();
	</script>
</Layout>
