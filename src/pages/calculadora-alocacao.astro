---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Calcule seu profissional alocado | E3M Solutions">
	<Header />

	<main class="flex-grow pt-24 pb-20 overflow-hidden">
		<section class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8 text-center">
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6 leading-tight text-white">
				Calcule seu <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-blue-400 to-accent-violet">profissional alocado</span>
			</h1>
			<p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
				Quanto custa alocar um dev, QA, UX ou especialista em IA no seu time? Ajuste o perfil e veja a faixa mensal — sem reunião comercial.
			</p>
		</section>

		<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="glass-panel p-8 rounded-3xl border border-white/10 space-y-6">
				<div>
					<label class="block text-sm font-bold text-slate-200 mb-2" for="perfil">Perfil</label>
					<select id="perfil" class="w-full rounded-xl bg-slate-900 border border-white/10 px-4 py-3 text-white">
						<option value="1.0">Desenvolvedor front-end / back-end</option>
						<option value="1.1">Desenvolvedor full-stack / mobile</option>
						<option value="1.0">QA / testes</option>
						<option value="1.0">UX / produto</option>
						<option value="1.25">IA / dados / automação</option>
						<option value="1.6">Tech Lead as a Service</option>
					</select>
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-200 mb-2" for="senioridade">Senioridade</label>
					<select id="senioridade" class="w-full rounded-xl bg-slate-900 border border-white/10 px-4 py-3 text-white">
						<option value="100">Júnior — R$ 100/h referência</option>
						<option value="125" selected>Pleno — R$ 125/h referência</option>
						<option value="150">Sênior — R$ 150/h referência</option>
					</select>
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-200 mb-2" for="dedicacao">Dedicação semanal</label>
					<select id="dedicacao" class="w-full rounded-xl bg-slate-900 border border-white/10 px-4 py-3 text-white">
						<option value="80">20h/semana (meio período)</option>
						<option value="120">30h/semana</option>
						<option value="160" selected>40h/semana (integral)</option>
					</select>
				</div>
				<div class="rounded-2xl bg-accent-cyan/[0.06] border border-accent-cyan/30 p-6 text-center">
					<p class="text-sm text-slate-300 mb-1">Estimativa mensal</p>
					<p id="resultado" class="text-3xl font-extrabold text-white">R$ 20.000 – R$ 24.000</p>
					<p class="text-xs text-slate-400 mt-2">Faixa de referência E3M (PJ, remoto). Valor final no diagnóstico gratuito, conforme escopo e prazo.</p>
				</div>
				<div class="text-center">
					<a href="/contato" class="inline-block px-8 py-3 rounded-xl bg-accent-cyan text-slate-950 font-bold">Solicitar profissional / orçamento</a>
					<p class="text-xs text-slate-400 mt-3">Início típico em 1–2 semanas. Sem multa após 90 dias.</p>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<script>
		const $ = (id) => document.getElementById(id);
		function calc() {
			const base = Number($('senioridade').value);
			const mult = Number($('perfil').value);
			const horas = Number($('dedicacao').value);
			const min = Math.round(base * mult * horas * 0.9 / 500) * 500;
			const max = Math.round(base * mult * horas * 1.1 / 500) * 500;
			const fmt = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
			$('resultado').textContent = fmt(min) + ' – ' + fmt(max);
		}
		['perfil', 'senioridade', 'dedicacao'].forEach((id) => $(id).addEventListener('change', calc));
		calc();
	</script>
</Layout>
