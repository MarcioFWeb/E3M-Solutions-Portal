---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="E3M Solutions | Engenharia de Software, Nuvem & IA">
	<Header />
	
	<main class="flex-grow pt-24 pb-16">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
			<div class="text-center max-w-3xl mx-auto mb-20">
				<h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
					E3M Solutions — Engenharia de Software, Nuvem & <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan to-accent-violet">IA descomplicadas.</span>
				</h1>
				<p class="text-lg md:text-xl text-slate-300 mb-10">
					Com mais de 25 anos de mercado e liderança técnica, transformamos desafios complexos em soluções digitais elegantes, escaláveis e eficientes.
				</p>
				<div class="flex flex-col sm:flex-row justify-center gap-4">
					<a href="/cases" class="glass-panel px-8 py-4 font-semibold text-white hover:bg-white/10 transition-colors rounded-xl flex items-center justify-center">
						Conheça Nossos Cases
					</a>
					<a href="/contato" class="px-8 py-4 font-semibold text-accent-cyan border border-accent-cyan/30 rounded-xl hover:bg-accent-cyan/10 transition-colors flex items-center justify-center">
						Agende um Diagnóstico Gratuito
					</a>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
				<!-- Placeholder Cards -->
				<div class="glass-card p-6">
					<div class="h-40 rounded-lg bg-white/5 mb-4 border border-white/5 flex items-center justify-center">
						<svg class="w-12 h-12 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-2 text-slate-50">Arquitetura de Nuvem Moderna</h3>
					<p class="text-slate-400 text-sm">Práticas e padrões para aplicações resilientes e escaláveis.</p>
				</div>
				<div class="glass-card p-6">
					<div class="h-40 rounded-lg bg-white/5 mb-4 border border-white/5 flex items-center justify-center">
						<svg class="w-12 h-12 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-2 text-slate-50">Engenharia com IA Integrada</h3>
					<p class="text-slate-400 text-sm">Como ferramentas agenticas aceleram o ciclo de desenvolvimento.</p>
				</div>
				<div class="glass-card p-6">
					<div class="h-40 rounded-lg bg-white/5 mb-4 border border-white/5 flex items-center justify-center">
						<svg class="w-12 h-12 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-2 text-slate-50">Gestão de Produto e MVP</h3>
					<p class="text-slate-400 text-sm">Transformando ideias em produtos viáveis com foco em valor real.</p>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
