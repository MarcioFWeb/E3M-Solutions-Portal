---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPath } from '../utils/paths';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const typeLabels: Record<string, string> = {
  case: 'Case',
  article: 'Artigo',
  opinion: 'Opinião',
  service: 'Serviço',
  experiment: 'Experimento',
  saas: 'SaaS',
  track: 'Trilha',
  recommendation: 'Recomendação',
};

const typeColors: Record<string, string> = {
  case: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
  article: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
  opinion: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
  service: 'bg-amber-500/20 text-amber-300 border-amber-500/30',
  experiment: 'bg-rose-500/20 text-rose-300 border-rose-500/30',
  saas: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
  track: 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30',
  recommendation: 'bg-teal-500/20 text-teal-300 border-teal-500/30',
};
---

<Layout title="E3M Solutions | Engenharia de Software, Nuvem & IA">
	<Header />
	
	<main class="flex-grow pt-24 pb-20 overflow-hidden">
		<!-- Hero Section -->
		<section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20 md:pt-24 md:pb-28">
			<!-- Background subtle ambient glow -->
			<div class="absolute -top-10 left-1/2 -translate-x-1/2 w-3/4 max-w-3xl h-96 bg-gradient-to-tr from-accent-cyan/15 to-accent-violet/15 blur-3xl pointer-events-none -z-10 rounded-full"></div>

			<div class="text-center max-w-4xl mx-auto">
				<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-panel text-sm font-medium text-slate-300 mb-8 border border-white/10">
					<span class="w-2 h-2 rounded-full bg-accent-cyan animate-pulse"></span>
					25+ anos de liderança técnica e soluções de alta criticidade
				</div>

				<h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight mb-8 leading-[1.15] text-white">
					Engenharia de Software, Nuvem & <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-blue-400 to-accent-violet">IA Descomplicadas</span>
				</h1>

				<p class="text-lg md:text-xl text-slate-300 mb-12 max-w-2xl mx-auto leading-relaxed">
					Aliamos solidez arquitetural a abordagens modernas de desenvolvimento, acelerando a entrega de valor com Inteligência Artificial, resiliência de nuvem e governança pragmática.
				</p>

				<div class="flex flex-col sm:flex-row justify-center gap-4 items-center">
					<a 
						href={getPath('/contato')} 
						class="w-full sm:w-auto px-8 py-4 font-semibold text-white bg-gradient-to-r from-accent-cyan to-accent-violet rounded-xl shadow-lg shadow-accent-cyan/20 hover:shadow-accent-cyan/40 hover:opacity-95 transition-all duration-200 text-center flex items-center justify-center gap-2"
					>
						Agende um Diagnóstico Estratégico
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
					</a>
					<a 
						href={getPath('/blog')} 
						class="w-full sm:w-auto glass-panel px-8 py-4 font-semibold text-slate-200 hover:text-white hover:bg-white/10 transition-colors rounded-xl text-center border border-white/15"
					>
						Explorar Artigos & Cases
					</a>
				</div>

				<!-- Stats / Highlights -->
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 pt-12 border-t border-white/10">
					<div class="p-4">
						<div class="text-3xl md:text-4xl font-extrabold text-white mb-1">25+</div>
						<div class="text-xs md:text-sm text-slate-400 font-medium">Anos de Experiência</div>
					</div>
					<div class="p-4">
						<div class="text-3xl md:text-4xl font-extrabold text-accent-cyan mb-1">Mission-Critical</div>
						<div class="text-xs md:text-sm text-slate-400 font-medium">Sistemas Resilientes</div>
					</div>
					<div class="p-4">
						<div class="text-3xl md:text-4xl font-extrabold text-white mb-1">Agentic AI</div>
						<div class="text-xs md:text-sm text-slate-400 font-medium">Engenharia Aumentada</div>
					</div>
					<div class="p-4">
						<div class="text-3xl md:text-4xl font-extrabold text-accent-violet mb-1">FinOps</div>
						<div class="text-xs md:text-sm text-slate-400 font-medium">Otimização de Custos</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Competencies / Services Section -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="text-xs md:text-sm uppercase tracking-widest text-accent-cyan font-bold mb-3">Nossas Especialidades</h2>
				<p class="text-3xl md:text-4xl font-bold text-white">
					Arquitetura sólida para um mundo de rápida evolução
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Service 1 -->
				<div class="glass-card p-8 flex flex-col group hover:-translate-y-1 transition-all duration-300">
					<div class="w-14 h-14 rounded-xl bg-accent-cyan/10 border border-accent-cyan/20 flex items-center justify-center text-accent-cyan mb-6 group-hover:scale-105 transition-transform">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Modernização & Nuvem Resiliente</h3>
					<p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
						Desenho de arquiteturas escaláveis em nuvens públicas (GCP, AWS), migração de legados, microsserviços e sistemas tolerantes a falhas.
					</p>
					<div class="text-xs font-semibold text-accent-cyan flex items-center gap-1">
						<span>Cloud-Native & Distributed Systems</span>
					</div>
				</div>

				<!-- Service 2 -->
				<div class="glass-card p-8 flex flex-col group hover:-translate-y-1 transition-all duration-300">
					<div class="w-14 h-14 rounded-xl bg-accent-violet/10 border border-accent-violet/20 flex items-center justify-center text-accent-violet mb-6 group-hover:scale-105 transition-transform">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Agentes de IA & Engenharia Aumentada</h3>
					<p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
						Integração de inteligência artificial generativa em fluxos de negócios e engenharia. Da concepção de pipelines RAG à automação com agentes autônomos.
					</p>
					<div class="text-xs font-semibold text-accent-violet flex items-center gap-1">
						<span>LLMs, RAG & Autonomous Workflows</span>
					</div>
				</div>

				<!-- Service 3 -->
				<div class="glass-card p-8 flex flex-col group hover:-translate-y-1 transition-all duration-300">
					<div class="w-14 h-14 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-105 transition-transform">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">FinOps & Governança Operacional</h3>
					<p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
						Otimização de custos de computação e infraestrutura, observabilidade proativa e governança para garantir eficiência máxima de investimento em TI.
					</p>
					<div class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
						<span>Cost Optimization & Observability</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Recent Articles Section -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="flex flex-col md:flex-row justify-between items-baseline mb-12">
				<div>
					<h2 class="text-xs md:text-sm uppercase tracking-widest text-accent-cyan font-bold mb-2">Conhecimento & Insights</h2>
					<p class="text-3xl font-bold text-white">Artigos e Reflexões Recentes</p>
				</div>
				<a 
					href={getPath('/blog')} 
					class="mt-4 md:mt-0 text-sm font-semibold text-accent-cyan hover:text-white transition-colors inline-flex items-center gap-1"
				>
					Ver todos os artigos &rarr;
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{recentPosts.map((post) => (
					<a 
						href={getPath(`/blog/${post.id}`)}
						class="glass-card p-6 flex flex-col group hover:-translate-y-1 transition-all duration-300"
					>
						<div class="flex items-center justify-between mb-4">
							<span class={`text-xs font-semibold px-2.5 py-0.5 rounded-md border ${typeColors[post.data.type] || 'bg-white/10 text-slate-300 border-white/20'}`}>
								{typeLabels[post.data.type] || post.data.type}
							</span>
							<span class="text-xs text-slate-400">
								{new Date(post.data.pubDate).toLocaleDateString('pt-BR', {
									day: '2-digit',
									month: 'short',
									year: 'numeric'
								})}
							</span>
						</div>
						<h3 class="text-lg font-bold mb-3 text-white group-hover:text-accent-cyan transition-colors line-clamp-2">
							{post.data.title}
						</h3>
						<p class="text-slate-400 text-sm flex-grow mb-6 line-clamp-3">
							{post.data.description}
						</p>
						<div class="flex items-center text-xs font-semibold text-accent-cyan mt-auto">
							<span>Ler artigo completo</span>
							<svg class="w-3.5 h-3.5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- Final CTA Conversion Banner -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="glass-panel p-8 md:p-14 rounded-3xl border border-white/15 relative overflow-hidden text-center">
				<div class="absolute -bottom-10 right-0 w-80 h-80 bg-accent-violet/10 blur-3xl pointer-events-none rounded-full"></div>
				<div class="absolute -top-10 left-0 w-80 h-80 bg-accent-cyan/10 blur-3xl pointer-events-none rounded-full"></div>
				
				<h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 max-w-2xl mx-auto leading-tight">
					Tem um desafio crítico de arquitetura ou engenharia?
				</h2>
				<p class="text-slate-300 text-base md:text-lg mb-8 max-w-xl mx-auto">
					Converse diretamente com quem possui mais de duas décadas de experiência prática resolvendo gargalos de escala, tecnologia e nuvem.
				</p>
				<a 
					href={getPath('/contato')} 
					class="inline-flex items-center gap-2 px-8 py-4 font-semibold text-white bg-gradient-to-r from-accent-cyan to-accent-violet rounded-xl shadow-lg shadow-accent-cyan/25 hover:shadow-accent-cyan/40 hover:opacity-95 transition-all"
				>
					Fale com um Especialista
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
