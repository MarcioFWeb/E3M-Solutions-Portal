---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPath } from '../utils/paths';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((post) => post.data.type === 'artigo' || post.data.type === 'video')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const typeLabels: Record<string, string> = {
  case: 'Case',
  artigo: 'Artigo',
  video: 'Vídeo',
};

const typeColors: Record<string, string> = {
  case: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
  artigo: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
  video: 'bg-rose-500/20 text-rose-300 border-rose-500/30',
};
---

<Layout title="E3M Solutions | Engenharia de Software, Nuvem & IA">
	<Header />
	
	<main class="flex-grow pt-24 pb-20 overflow-hidden">
		<!-- Hero Section -->
		<section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20 md:pt-24 md:pb-28">
			<!-- Background subtle ambient glow -->
			<div class="absolute -top-10 left-1/2 -translate-x-1/2 w-3/4 max-w-3xl h-96 bg-gradient-to-tr from-accent-cyan/15 to-accent-violet/15 blur-3xl pointer-events-none -z-10 rounded-full"></div>

			<div class="text-center max-w-4xl mx-auto">
				<h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight mb-8 leading-[1.15] text-white">
					Soluções Inteligentes em Software, <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-blue-400 to-accent-violet">Nuvem e IA</span>
				</h1>

				<p class="text-lg md:text-xl text-slate-300 mb-12 max-w-2xl mx-auto leading-relaxed">
					Somos seu parceiro tecnológico para arquiteturas complexas, adoção de IA Generativa e modernização. Entregamos soluções resilientes que impulsionam o seu negócio, sem complicações.
				</p>

				<div class="flex flex-col sm:flex-row justify-center gap-4 items-center">
					<a 
						href={getPath('/contato')} 
						class="w-full sm:w-auto px-8 py-4 font-semibold text-white bg-gradient-to-r from-accent-cyan to-accent-violet rounded-xl shadow-lg shadow-accent-cyan/20 hover:shadow-accent-cyan/40 hover:opacity-95 transition-all duration-200 text-center flex items-center justify-center gap-2"
					>
						Agende um Diagnóstico Estratégico
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
					</a>
					<a 
						href={getPath('/blog')} 
						class="w-full sm:w-auto glass-panel px-8 py-4 font-semibold text-slate-200 hover:text-white hover:bg-white/10 transition-colors rounded-xl text-center border border-white/15"
					>
						Explorar Artigos & Cases
					</a>
				</div>

				<!-- Tipos de Soluções & Capacidades Entregues -->
				<div class="mt-16 pt-12 border-t border-white/10">
					<p class="text-xs uppercase tracking-widest text-slate-400 font-semibold mb-6">
						Tipos de Soluções que Desenhamos, Construímos & Sustentamos
					</p>
					
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
						<!-- Card 1: IA & Agentes -->
						<div class="glass-card p-5 rounded-2xl hover:border-accent-cyan/40 transition-all group">
							<div class="w-10 h-10 rounded-xl bg-accent-cyan/10 border border-accent-cyan/20 flex items-center justify-center text-accent-cyan mb-3 group-hover:scale-105 transition-transform">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
							</div>
							<h3 class="text-base font-bold text-white mb-1">IA & Agentes Autônomos</h3>
							<p class="text-xs text-slate-400 leading-relaxed">Workflows inteligentes, RAG corporativo e agentes conversacionais conectados às suas ferramentas.</p>
						</div>

						<!-- Card 2: Automações & Integrações -->
						<div class="glass-card p-5 rounded-2xl hover:border-accent-violet/40 transition-all group">
							<div class="w-10 h-10 rounded-xl bg-accent-violet/10 border border-accent-violet/20 flex items-center justify-center text-accent-violet mb-3 group-hover:scale-105 transition-transform">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
							</div>
							<h3 class="text-base font-bold text-white mb-1">Automações & Integrações</h3>
							<p class="text-xs text-slate-400 leading-relaxed">Conexão fluida entre APIs, ERPs, CRMs, WhatsApp e fluxos de dados com observabilidade ponta a ponta.</p>
						</div>

						<!-- Card 3: SaaS, Portais & Cloud -->
						<div class="glass-card p-5 rounded-2xl hover:border-blue-500/40 transition-all group">
							<div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 mb-3 group-hover:scale-105 transition-transform">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
							</div>
							<h3 class="text-base font-bold text-white mb-1">SaaS, Portais & Nuvem</h3>
							<p class="text-xs text-slate-400 leading-relaxed">Desenvolvimento web moderno, micro-SaaS, modernização de legados e arquiteturas resilientes na GCP/AWS.</p>
						</div>

						<!-- Card 4: DEV Agêntico & Times -->
						<div class="glass-card p-5 rounded-2xl hover:border-emerald-500/40 transition-all group">
							<div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-3 group-hover:scale-105 transition-transform">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
							</div>
							<h3 class="text-base font-bold text-white mb-1">DEV Agêntico & Times</h3>
							<p class="text-xs text-slate-400 leading-relaxed">Engenharia aumentada por IA, mentoria técnica, Spec-Driven Development e squads alocadas com liderança.</p>
						</div>
					</div>

					<!-- Solution Tags Strip -->
					<div class="flex flex-wrap justify-center items-center gap-2 mt-6">
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">IA Generativa & RAG</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">Agentes Autônomos</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">Automações & Webhooks</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">Integrações de APIs & ERPs</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">SaaS & Apps</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">Modernização Cloud</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">Portais Corporativos</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">DEV Agêntico</span>
						<span class="text-xs bg-white/5 border border-white/10 text-slate-300 px-3 py-1 rounded-full">Staff Augmentation com Gestão</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Competencies / Services Section -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="text-xs md:text-sm uppercase tracking-widest text-accent-cyan font-bold mb-3">Nossas Especialidades</h2>
				<p class="text-3xl md:text-4xl font-bold text-white">
					Arquitetura sólida para um mundo de rápida evolução
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Service 1: IA & Agentes -->
				<div class="glass-card p-8 flex flex-col group hover:-translate-y-1 transition-all duration-300">
					<div class="w-14 h-14 rounded-xl bg-accent-cyan/10 border border-accent-cyan/20 flex items-center justify-center text-accent-cyan mb-6 group-hover:scale-105 transition-transform">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">IA, Automação & Agentes Autônomos</h3>
					<p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
						Ecossistemas com agentes de IA, automação inteligente de processos, RAG corporativo e assistentes conversacionais (WhatsApp/omnichannel) integrados aos seus sistemas e ferramentas de negócio.
					</p>
					<div class="text-xs font-semibold text-accent-cyan flex items-center gap-1">
						<span>RAG Corporativo, Workflows & Chatbots</span>
					</div>
				</div>

				<!-- Service 2: Nuvem, SaaS & Licitações -->
				<div class="glass-card p-8 flex flex-col group hover:-translate-y-1 transition-all duration-300">
					<div class="w-14 h-14 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 mb-6 group-hover:scale-105 transition-transform">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">SaaS, Nuvem Moderna & Parcerias</h3>
					<p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
						Concepção de plataformas digitais, micro-SaaS, arquiteturas serverless/cloud escaláveis (GCP e AWS), modernização de legados e atuação técnica conjunta em licitações e editais públicos.
					</p>
					<div class="text-xs font-semibold text-blue-400 flex items-center gap-1">
						<span>Cloud-Native, Portais & Licitações</span>
					</div>
				</div>

				<!-- Service 3: Liderança & Alocação -->
				<div class="glass-card p-8 flex flex-col group hover:-translate-y-1 transition-all duration-300">
					<div class="w-14 h-14 rounded-xl bg-accent-violet/10 border border-accent-violet/20 flex items-center justify-center text-accent-violet mb-6 group-hover:scale-105 transition-transform">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Liderança Técnica & Staff Augmentation</h3>
					<p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
						CTO as a Service fracionário, mentoria prática para squads internas (Spec-Driven Development e Dev Agêntico) e alocação de desenvolvedores com acompanhamento contínuo da E3M.
					</p>
					<div class="text-xs font-semibold text-accent-violet flex items-center gap-1">
						<span>CTO as a Service & Squads com Gestão</span>
					</div>
				</div>
			</div>

			<div class="text-center mt-10">
				<a href={getPath('/servicos')} class="inline-flex items-center gap-2 text-sm font-semibold text-accent-cyan hover:text-white transition-colors">
					Ver todas as 5 verticais e nossa metodologia completa &rarr;
				</a>
			</div>
		</section>

		<!-- Recent Articles Section -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="flex flex-col md:flex-row justify-between items-baseline mb-12">
				<div>
					<h2 class="text-xs md:text-sm uppercase tracking-widest text-accent-cyan font-bold mb-2">Conhecimento & Insights</h2>
					<p class="text-3xl font-bold text-white">Artigos e Reflexões Recentes</p>
				</div>
				<a 
					href={getPath('/blog')} 
					class="mt-4 md:mt-0 text-sm font-semibold text-accent-cyan hover:text-white transition-colors inline-flex items-center gap-1"
				>
					Ver todos os artigos &rarr;
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{recentPosts.map((post) => (
					<a 
						href={getPath(`/blog/${post.id}`)}
						class="glass-card p-6 flex flex-col group hover:-translate-y-1 transition-all duration-300"
					>
						<div class="flex items-center justify-between mb-4">
							<span class={`text-xs font-semibold px-2.5 py-0.5 rounded-md border ${typeColors[post.data.type] || 'bg-white/10 text-slate-300 border-white/20'}`}>
								{typeLabels[post.data.type] || post.data.type}
							</span>
							<span class="text-xs text-slate-400">
								{new Date(post.data.pubDate).toLocaleDateString('pt-BR', {
									day: '2-digit',
									month: 'short',
									year: 'numeric'
								})}
							</span>
						</div>
						<h3 class="text-lg font-bold mb-3 text-white group-hover:text-accent-cyan transition-colors line-clamp-2">
							{post.data.title}
						</h3>
						<p class="text-slate-400 text-sm flex-grow mb-6 line-clamp-3">
							{post.data.description}
						</p>
						<div class="flex items-center text-xs font-semibold text-accent-cyan mt-auto">
							<span>Ler artigo completo</span>
							<svg class="w-3.5 h-3.5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- Final CTA Conversion Banner -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="glass-panel p-8 md:p-14 rounded-3xl border border-white/15 relative overflow-hidden text-center">
				<div class="absolute -bottom-10 right-0 w-80 h-80 bg-accent-violet/10 blur-3xl pointer-events-none rounded-full"></div>
				<div class="absolute -top-10 left-0 w-80 h-80 bg-accent-cyan/10 blur-3xl pointer-events-none rounded-full"></div>
				
				<h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 max-w-3xl mx-auto leading-tight">
					Transforme sua operação com Inteligência Artificial e Engenharia de Software estruturada
				</h2>
				<p class="text-slate-300 text-base md:text-lg mb-8 max-w-2xl mx-auto">
					Conte com a E3M Solutions para estruturar, acelerar ou sustentar sua tecnologia com excelência técnica, pragmatismo e foco nos seus resultados.
				</p>
				<a 
					href={getPath('/contato')} 
					class="inline-flex items-center gap-2 px-8 py-4 font-semibold text-white bg-gradient-to-r from-accent-cyan to-accent-violet rounded-xl shadow-lg shadow-accent-cyan/25 hover:shadow-accent-cyan/40 hover:opacity-95 transition-all"
				>
					Fale com um Especialista
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
