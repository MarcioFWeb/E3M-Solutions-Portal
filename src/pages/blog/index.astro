---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogFeed from '../../components/BlogFeed';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const blogPosts = allPosts
  .filter((post) => post.data.type === 'artigo' || post.data.type === 'video')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog & Insights | E3M Solutions">
	<Header />
	
	<main class="flex-grow pt-32 pb-16">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h1 class="text-4xl md:text-5xl font-extrabold mb-6">
					Artigos, Conteúdos e <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan to-accent-violet">Insights</span>
				</h1>
				<p class="text-lg text-slate-300">
					Compartilhamos conhecimento técnico aprofundado, visão arquitetural e experiências práticas
					sobre engenharia de software, computação em nuvem e inteligência artificial.
				</p>
			</div>

			<BlogFeed posts={blogPosts} client:load />
		</div>
	</main>

	<Footer />
</Layout>
