---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPath } from '../utils/paths';
---

<Layout title="Sobre Nós & Liderança | E3M Solutions">
	<Header />
	
	<main class="flex-grow pt-24 pb-20 overflow-hidden">
		<!-- Hero Section -->
		<section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-16 md:pt-20 md:pb-24">
			<div class="absolute -top-10 left-1/2 -translate-x-1/2 w-3/4 max-w-3xl h-96 bg-gradient-to-tr from-accent-cyan/15 to-accent-violet/15 blur-3xl pointer-events-none -z-10 rounded-full"></div>

			<div class="text-center max-w-3xl mx-auto">
				<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-panel text-sm font-medium text-slate-300 mb-6 border border-white/10">
					<span class="w-2 h-2 rounded-full bg-accent-cyan animate-pulse"></span>
					Institucional &bull; Propósito & Liderança Técnica
				</div>

				<h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight text-white">
					Engenharia Prática, Inteligência Artificial e <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-blue-400 to-accent-violet">Foco no Seu Resultado</span>
				</h1>

				<p class="text-lg md:text-xl text-slate-300 leading-relaxed">
					A E3M Solutions é uma consultoria estruturada de tecnologia. Construímos soluções digitais robustas, acoplamos inteligência artificial e aceleramos negócios com governança e pragmatismo.
				</p>
			</div>
		</section>

		<!-- Quem Somos -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="glass-panel p-8 md:p-12 rounded-3xl border border-white/15">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
					<div class="lg:col-span-7">
						<span class="text-xs uppercase tracking-widest text-accent-cyan font-bold block mb-2">Quem Somos</span>
						<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
							Uma parceira de engenharia que resolve problemas reais de ponta a ponta
						</h2>
						<p class="text-slate-300 text-base leading-relaxed mb-4">
							Não somos apenas uma fábrica de software tradicional. A <strong>E3M Solutions</strong> é a parceira técnica que empresas e líderes procuram quando precisam desenhar, construir, integrar ou sustentar soluções complexas: de plataformas SaaS e automações de processos a agentes autônomos de IA e modernização em nuvem.
						</p>
						<p class="text-slate-300 text-base leading-relaxed">
							Nosso compromisso é apoiar o contratante em <strong>sua missão</strong>: entregamos a capacidade técnica e a inteligência necessárias para que você atinja suas metas de ROI, tempo, performance, escalabilidade e visibilidade. Além disso, <strong>treinamos e capacitamos seus times</strong> para garantir autonomia tecnológica contínua.
						</p>
					</div>

					<div class="lg:col-span-5 grid grid-cols-2 gap-4">
						<div class="glass-card p-5 rounded-2xl text-center">
							<div class="text-2xl font-extrabold text-accent-cyan mb-1">Pragmatismo</div>
							<div class="text-xs text-slate-400 font-medium">Arquitetura sem Overengineering</div>
						</div>
						<div class="glass-card p-5 rounded-2xl text-center">
							<div class="text-2xl font-extrabold text-accent-violet mb-1">AI-Native</div>
							<div class="text-xs text-slate-400 font-medium">Agentes & Workflows Modernos</div>
						</div>
						<div class="glass-card p-5 rounded-2xl text-center">
							<div class="text-2xl font-extrabold text-emerald-400 mb-1">Zero Lock-in</div>
							<div class="text-xs text-slate-400 font-medium">Capacitação & Repasse Total</div>
						</div>
						<div class="glass-card p-5 rounded-2xl text-center">
							<div class="text-2xl font-extrabold text-amber-400 mb-1">ROI Real</div>
							<div class="text-xs text-slate-400 font-medium">Tecnologia com Retorno Claro</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 5 Verticais de Atuação da E3M -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="text-center max-w-3xl mx-auto mb-14">
				<span class="text-xs md:text-sm uppercase tracking-widest text-accent-cyan font-bold block mb-3">Escopo de Atuação</span>
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
					Nossas 5 Verticais de Especialidade
				</h2>
				<p class="text-slate-300 text-base">
					Capacidades multidisciplinares para desenhar, construir, integrar e sustentar tecnologia de alta fidelidade.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				<!-- Vertical 1 -->
				<div class="glass-card p-6 rounded-2xl flex flex-col justify-between hover:border-accent-cyan/40 transition-all">
					<div>
						<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-accent-cyan/10 border border-accent-cyan/25 text-accent-cyan text-xs font-semibold uppercase tracking-wider mb-4">
							Vertical 01 &bull; IA & Automação
						</div>
						<h3 class="text-lg font-bold text-white mb-2">IA Agêntica & Automação Inteligente</h3>
						<p class="text-xs text-slate-300 leading-relaxed mb-4">
							Agentes autônomos integrados a ferramentas corporativas, pipelines avançados de RAG, automação inteligente de processos e FinOps de LLM para máxima eficiência de custos.
						</p>
					</div>
					<div class="pt-4 border-t border-white/10 flex flex-wrap gap-1.5">
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">RAG Corporativo</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Agentes Autônomos</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">IAOps</span>
					</div>
				</div>

				<!-- Vertical 2 -->
				<div class="glass-card p-6 rounded-2xl flex flex-col justify-between hover:border-accent-violet/40 transition-all">
					<div>
						<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-accent-violet/10 border border-accent-violet/25 text-accent-violet text-xs font-semibold uppercase tracking-wider mb-4">
							Vertical 02 &bull; Liderança & Mentoria
						</div>
						<h3 class="text-lg font-bold text-white mb-2">Mentoria Técnica & CTO as a Service</h3>
						<p class="text-xs text-slate-300 leading-relaxed mb-4">
							Direcionamento técnico estratégico, Spec-Driven Development (SDD), upskilling de equipes internas e engenharia aumentada por IA com acompanhamento executivo experiente.
						</p>
					</div>
					<div class="pt-4 border-t border-white/10 flex flex-wrap gap-1.5">
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">CTO as a Service</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">SDD & Dev Agêntico</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Mentoria</span>
					</div>
				</div>

				<!-- Vertical 3 -->
				<div class="glass-card p-6 rounded-2xl flex flex-col justify-between hover:border-emerald-500/40 transition-all">
					<div>
						<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
							Vertical 03 &bull; Atendimento & Omnichannel
						</div>
						<h3 class="text-lg font-bold text-white mb-2">Chatbots & WhatsApp com IA</h3>
						<p class="text-xs text-slate-300 leading-relaxed mb-4">
							Assistentes conversacionais inteligentes conectados a ERPs, CRMs e WhatsApp API Oficial. Resolução rápida de chamados 24/7 com transbordo humano fluido.
						</p>
					</div>
					<div class="pt-4 border-t border-white/10 flex flex-wrap gap-1.5">
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">WhatsApp API</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Integração CRM/ERP</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Transbordo Humano</span>
					</div>
				</div>

				<!-- Vertical 4 -->
				<div class="glass-card p-6 rounded-2xl flex flex-col justify-between hover:border-blue-500/40 transition-all">
					<div>
						<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-blue-500/10 border border-blue-500/25 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
							Vertical 04 &bull; Engenharia & Parcerias
						</div>
						<h3 class="text-lg font-bold text-white mb-2">SaaS, Nuvem & Parcerias em Licitações</h3>
						<p class="text-xs text-slate-300 leading-relaxed mb-4">
							Desenvolvimento de micro-SaaS, portais corporativos, arquiteturas em nuvem (GCP/AWS) e atuação como parceiro tecnológico operacional em licitações públicas e editais.
						</p>
					</div>
					<div class="pt-4 border-t border-white/10 flex flex-wrap gap-1.5">
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">SaaS & Portais</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Parceria em Editais</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Cloud GCP/AWS</span>
					</div>
				</div>

				<!-- Vertical 5 -->
				<div class="glass-card p-6 rounded-2xl flex flex-col justify-between hover:border-amber-500/40 transition-all md:col-span-2 lg:col-span-2">
					<div>
						<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-500/10 border border-amber-500/25 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
							Vertical 05 &bull; Alocação com Gestão
						</div>
						<h3 class="text-lg font-bold text-white mb-2">Staff Augmentation com Liderança Técnica Integrada</h3>
						<p class="text-xs text-slate-300 leading-relaxed mb-4">
							Alocação de talentos técnicos (desenvolvedores, engenheiros de dados e IA, QAs e líderes) com diferencial decisivo: suporte contínuo, mentoria e code reviews da liderança técnica da E3M. Garantia de padrão de qualidade sem sobrecarregar sua gestão interna.
						</p>
					</div>
					<div class="pt-4 border-t border-white/10 flex flex-wrap gap-1.5">
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Devs & Engenheiros Selecionados</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Suporte Técnico E3M</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Qualidade Garantida</span>
						<span class="text-[11px] bg-white/5 border border-white/10 text-slate-300 px-2.5 py-0.5 rounded-full">Zero Microgestão</span>
					</div>
				</div>
			</div>

			<div class="text-center mt-10">
				<a href={getPath('/servicos')} class="inline-flex items-center gap-2 text-sm font-semibold text-accent-cyan hover:text-white transition-colors">
					Conheça a metodologia detalhada e escopo completo de serviços &rarr;
				</a>
			</div>
		</section>

		<!-- Manifesto de Engenharia E3M -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="text-xs md:text-sm uppercase tracking-widest text-accent-cyan font-bold mb-3">Nosso Manifesto</h2>
				<p class="text-3xl md:text-4xl font-bold text-white">
					Como enxergamos a tecnologia e a parceria com nossos clientes
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<!-- Card 1 -->
				<div class="glass-card p-8 flex flex-col">
					<div class="w-12 h-12 rounded-xl bg-accent-cyan/10 border border-accent-cyan/30 flex items-center justify-center text-accent-cyan mb-5">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">1. O Objetivo é Sempre do Cliente</h3>
					<p class="text-slate-300 text-sm leading-relaxed">
						Nossa missão é habilitar as <strong>suas metas</strong>: ROI, lucratividade, velocidade de lançamento, redução de custos, performance, visibilidade ou satisfação do usuário final. Tecnologia é meio, não fim. Não empurramos ferramentas para inflar ego técnico; recomendamos o que gera impacto direto na sua linha de chegada.
					</p>
				</div>

				<!-- Card 2 -->
				<div class="glass-card p-8 flex flex-col">
					<div class="w-12 h-12 rounded-xl bg-accent-violet/10 border border-accent-violet/30 flex items-center justify-center text-accent-violet mb-5">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">2. Combate Ativo ao Overengineering & Custos Inúteis</h3>
					<p class="text-slate-300 text-sm leading-relaxed">
						Evitamos gostos pessoais, "stacks de estimação" ou modismos passageiros. Buscamos arquiteturas simples, escaláveis e de fácil sustentação. Aplicamos princípios rígidos de FinOps, DevOps e IAOps para que cada centavo investido em infraestrutura e licenças se justifique economicamente.
					</p>
				</div>

				<!-- Card 3 -->
				<div class="glass-card p-8 flex flex-col">
					<div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-5">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">3. Valor Justo e Compatível com o Retorno</h3>
					<p class="text-slate-300 text-sm leading-relaxed">
						Acreditamos em relações comerciais saudáveis e sustentáveis. Nossos honorários são proporcionais à complexidade e ao retorno que entregamos para o negócio. Trabalhamos com clareza de escopo, previsibilidade de entregas e foco absoluto em relações de longo prazo baseadas em confiança mútua.
					</p>
				</div>

				<!-- Card 4 -->
				<div class="glass-card p-8 flex flex-col">
					<div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-5">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3">4. Capacitação, Treinamento & Repasse Total</h3>
					<p class="text-slate-300 text-sm leading-relaxed">
						Não criamos caixas-pretas para prender o contratante. Treinamos os usuários, capacitamos os desenvolvedores internos e entregamos documentação viva e automações completas. O cliente deve permanecer conosco pela qualidade contínua da nossa entrega, nunca por dependência técnica forçada.
					</p>
				</div>
			</div>
		</section>

		<!-- Liderança Marcio Figueiredo -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="glass-panel p-8 md:p-14 rounded-3xl border border-white/15 relative overflow-hidden">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
					<!-- Coluna Visual / Avatar -->
					<div class="lg:col-span-4 flex flex-col items-center text-center">
						<div class="relative mb-6 group">
							<div class="w-48 h-48 rounded-2xl bg-gradient-to-tr from-accent-cyan to-accent-violet p-1 shadow-2xl shadow-accent-cyan/20">
								<div class="w-full h-full rounded-[14px] bg-midnight flex items-center justify-center overflow-hidden border border-white/10">
									<img 
										src={getPath('/images/MARCIO_PERFIL.jpg')} 
										alt="Marcio Figueiredo" 
										class="w-full h-full object-cover"
									/>
								</div>
							</div>
							<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent-cyan/15 border border-accent-cyan/30 text-accent-cyan text-xs font-semibold mt-4">
								<span>Desde 1996</span>
								<span>&bull;</span>
								<span>+30 anos de mercado</span>
							</div>
						</div>
						
						<div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 w-full">
							<a 
								href="https://www.linkedin.com/in/marciofigueiredoweb" 
								target="_blank" 
								rel="noopener noreferrer"
								class="glass-panel px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors rounded-xl flex items-center gap-2 border border-white/15 w-full justify-center"
							>
								<svg class="w-4 h-4 text-accent-cyan" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
								Conectar no LinkedIn
							</a>
							<a 
								href="https://github.com/marciofweb" 
								target="_blank" 
								rel="noopener noreferrer"
								class="glass-panel px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors rounded-xl flex items-center gap-2 border border-white/15 w-full justify-center"
							>
								<svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
								Ver GitHub
							</a>
						</div>
					</div>

					<!-- Coluna Bio, Especialidades e Certificações -->
					<div class="lg:col-span-8">
						<span class="text-xs uppercase tracking-widest text-accent-violet font-bold block mb-2">Liderança Técnica</span>
						<h2 class="text-3xl font-extrabold text-white mb-6">
							Marcio Figueiredo
						</h2>
						<p class="text-slate-300 text-base leading-relaxed mb-4">
							Com atuação ininterrupta na vanguarda do desenvolvimento de software e infraestrutura desde 1996, Marcio Figueiredo acumula mais de 30 anos de experiência prática na concepção, liderança de engenharia e entrega de projetos complexos em setores exigentes: sistemas de missão crítica, telecomunicações, radiodifusão, automação corporativa e arquiteturas escaláveis em nuvem.
						</p>
						<p class="text-slate-300 text-base leading-relaxed mb-6">
							Hoje, lidera a E3M Solutions combinando essa sólida fundação de engenharia com os paradigmas mais avançados de Inteligência Artificial generativa, times aumentados por agentes, Spec-Driven Development (SDD) e governança pragmática.
						</p>

						<!-- Grid de Especialidades -->
